    "astro": "^5.16.7",
    "gun": "^0.2020.1241",
    "hono": "^4.11.10",
    "jsqr": "^1.4.0",
    "lit": "^3.3.2",
    "posthog-js": "^1.318.1",
    "qrcode": "^1.5.4",
    "unocss": "^66.5.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.1",
    "@types/gun": "^0.9.6",
    "@types/qrcode": "^1.5.6",
    "happy-dom": "^20.1.0",
