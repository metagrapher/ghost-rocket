---
// Admin Dashboard for Rave Archive
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>PARTY ADMIN | RAVE ARCADE</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            :root {
                --neon-purple: #bc13fe;
                --neon-blue: #00f3ff;
                --neon-pink: #ff00ff;
                --dark-bg: #0a0a0c;
            }

            body {
                margin: 0;
                background-color: var(--dark-bg);
                color: #e0e0e0;
                font-family: "Inter", sans-serif;
                background-image:
                    radial-gradient(
                        circle at 20% 30%,
                        rgba(188, 19, 254, 0.15) 0%,
                        transparent 50%
                    ),
                    radial-gradient(
                        circle at 80% 70%,
                        rgba(0, 243, 255, 0.15) 0%,
                        transparent 50%
                    );
                min-height: 100vh;
            }

            .glass {
                background: rgba(255, 255, 255, 0.05);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.1);
            }

            .neon-text-purple {
                text-shadow: 0 0 20px rgba(188, 19, 254, 0.5);
            }

            .neon-border-blue {
                box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);
            }

            dialog::backdrop {
                background: rgba(0, 0, 0, 0.8);
                backdrop-filter: blur(5px);
            }
        </style>
    </head>
    <body class="p-8">
        <div class="max-w-7xl mx-auto">
            <header
                class="flex justify-between items-center mb-12 border-b border-white/10 pb-6"
            >
                <h1
                    class="text-4xl font-900 tracking-tighter bg-gradient-to-r from-white to-[#00f3ff] bg-clip-text text-transparent"
                >
                    RAVE <span class="text-[#bc13fe]">ADMIN</span>
                </h1>
                <div class="flex gap-4">
                    <button
                        id="btn-discover"
                        class="px-6 py-2 rounded-lg font-700 uppercase p-text-sm tracking-widest bg-gradient-to-br from-[#bc13fe] to-[#ff00ff] text-white hover:shadow-[0_0_30px_rgba(188,19,254,0.6)] transition-all transform hover:-translate-y-0.5"
                    >
                        Discover
                    </button>
                    <button
                        id="btn-scrape-all"
                        class="px-6 py-2 rounded-lg font-700 uppercase text-sm tracking-widest border border-[#00f3ff] text-[#00f3ff] hover:bg-[#00f3ff] hover:text-[#0a0a0c] transition-all"
                    >
                        Scrape Batch
                    </button>
                    <button
                        id="btn-enrich-next"
                        class="px-6 py-2 rounded-lg font-700 uppercase text-sm tracking-widest border border-[#bc13fe] text-[#bc13fe] hover:bg-[#bc13fe] hover:text-white transition-all"
                    >
                        Enrich Next
                    </button>
                    <a
                        href="/admin/costs"
                        class="px-6 py-2 rounded-lg font-700 uppercase text-sm tracking-widest bg-white/5 border border-white/10 text-white hover:bg-white/10 transition-all flex items-center"
                    >
                        Costs
                    </a>
                </div>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                <div class="glass rounded-2xl p-4 flex items-center gap-6">
                    <div
                        class="w-12 h-12 rounded-xl bg-[#bc13fe]/10 flex items-center justify-center text-[#bc13fe]"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <div
                            id="stat-total"
                            class="text-3xl font-900 text-[#bc13fe] mb-0.5 neon-text-purple"
                        >
                            -
                        </div>
                        <div
                            class="text-[0.6rem] uppercase tracking-widest opacity-40 font-800"
                        >
                            Total Parties
                        </div>
                    </div>
                </div>
                <div class="glass rounded-2xl p-4 flex items-center gap-6">
                    <div
                        class="w-12 h-12 rounded-xl bg-[#00f3ff]/10 flex items-center justify-center text-[#00f3ff]"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                            ></path></svg
                        >
                    </div>
                    <div>
                        <div
                            id="stat-scraped"
                            class="text-3xl font-900 text-[#00f3ff] mb-0.5"
                        >
                            -
                        </div>
                        <div
                            class="text-[0.6rem] uppercase tracking-widest opacity-40 font-800"
                        >
                            Scraped
                        </div>
                    </div>
                </div>
                <div class="glass rounded-2xl p-4 flex items-center gap-6">
                    <div
                        class="w-12 h-12 rounded-xl bg-[#ff00ff]/10 flex items-center justify-center text-[#ff00ff]"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                        >
                    </div>
                    <div>
                        <div
                            id="stat-enriched"
                            class="text-3xl font-900 text-[#ff00ff] mb-0.5"
                        >
                            -
                        </div>
                        <div
                            class="text-[0.6rem] uppercase tracking-widest opacity-40 font-800"
                        >
                            Enriched
                        </div>
                    </div>
                </div>
            </div>

            <div class="glass rounded-2xl overflow-hidden">
                <table class="w-full border-collapse">
                    <thead>
                        <tr
                            class="text-left bg-white/5 border-b border-white/10 text-xs uppercase tracking-widest opacity-50"
                        >
                            <th class="p-4 font-400">Party Details</th>
                            <th class="p-4 font-400">Scrape Status</th>
                            <th class="p-4 font-400">Enrichment</th>
                            <th class="p-4 font-400">Coordinates</th>
                            <th class="p-4 font-400">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="party-list">
                        <tr>
                            <td
                                colspan="5"
                                class="p-12 text-center opacity-30 italic text-lg"
                            >
                                Synchronizing archive...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Edit Modal -->
        <dialog
            id="edit-modal"
            class="glass rounded-2xl p-0 w-full max-w-md border border-white/20 text-white"
        >
            <div class="p-8 bg-black/40 backdrop-blur-xl">
                <header class="mb-8 flex items-center justify-between">
                    <h2
                        class="text-2xl font-900 tracking-tight bg-gradient-to-r from-white to-white/60 bg-clip-text text-transparent"
                    >
                        Data Adjustment
                    </h2>
                    <button
                        onclick="document.getElementById('edit-modal').close()"
                        class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 hover:bg-white/20 text-white/40 hover:text-white transition-all"
                        >&times;</button
                    >
                </header>

                <form id="edit-form" class="flex flex-col gap-6">
                    <input type="hidden" id="edit-id" />

                    <div class="space-y-1.5">
                        <label
                            class="block text-[0.65rem] font-800 uppercase tracking-[0.2em] text-white/60"
                        >
                            Party Title
                        </label>
                        <input
                            type="text"
                            id="edit-title"
                            class="w-full bg-white/5 border border-white/10 rounded-xl p-4 text-white hover:border-white/20 focus:border-[#bc13fe] focus:ring-1 focus:ring-[#bc13fe]/50 outline-none transition-all"
                        />
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-1.5">
                            <label
                                class="block text-[0.65rem] font-800 uppercase tracking-[0.2em] text-white/60"
                            >
                                Series
                            </label>
                            <input
                                type="text"
                                id="edit-series"
                                class="w-full bg-white/5 border border-white/10 rounded-xl p-4 text-white hover:border-white/20 focus:border-[#bc13fe] outline-none transition-all"
                            />
                        </div>
                        <div class="space-y-1.5">
                            <label
                                class="block text-[0.65rem] font-800 uppercase tracking-[0.2em] text-white/60"
                            >
                                Date
                            </label>
                            <input
                                type="text"
                                id="edit-date"
                                class="w-full bg-white/5 border border-white/10 rounded-xl p-4 text-white hover:border-white/20 focus:border-[#bc13fe] outline-none transition-all text-sm"
                                placeholder="YYYY-MM-DD"
                            />
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label
                            class="block text-[0.65rem] font-800 uppercase tracking-[0.2em] text-white/60"
                        >
                            Location Name
                        </label>
                        <input
                            type="text"
                            id="edit-location"
                            class="w-full bg-white/5 border border-white/10 rounded-xl p-4 text-white hover:border-white/20 focus:border-[#bc13fe] outline-none transition-all"
                        />
                    </div>

                    <div
                        class="grid grid-cols-2 gap-4 border-t border-white/5 pt-4"
                    >
                        <div class="space-y-1.5">
                            <label
                                class="block text-[0.65rem] font-800 uppercase tracking-[0.2em] text-white/60"
                            >
                                Latitude
                            </label>
                            <input
                                type="number"
                                step="any"
                                id="edit-lat"
                                class="w-full bg-white/5 border border-white/10 rounded-xl p-4 text-white hover:border-white/20 focus:border-[#bc13fe] outline-none transition-all font-mono text-sm"
                            />
                        </div>
                        <div class="space-y-1.5">
                            <label
                                class="block text-[0.65rem] font-800 uppercase tracking-[0.2em] text-white/60"
                            >
                                Longitude
                            </label>
                            <input
                                type="number"
                                step="any"
                                id="edit-lng"
                                class="w-full bg-white/5 border border-white/10 rounded-xl p-4 text-white hover:border-white/20 focus:border-[#bc13fe] outline-none transition-all font-mono text-sm"
                            />
                        </div>
                    </div>

                    <button
                        type="submit"
                        class="mt-4 w-full py-4 rounded-xl font-900 uppercase tracking-[0.15em] bg-gradient-to-r from-[#bc13fe] to-[#ff00ff] text-white shadow-[0_0_40px_rgba(188,19,254,0.3)] hover:shadow-[0_0_60px_rgba(188,19,254,0.5)] transition-all transform hover:-translate-y-0.5 active:translate-y-0"
                    >
                        Save Adjustments
                    </button>
                </form>
            </div>
        </dialog>

        <div
            id="toast"
            class="fixed bottom-8 right-8 bg-[#bc13fe] text-white px-6 py-3 rounded-lg font-700 shadow-2xl transition-transform translate-y-32 z-50"
        >
            Action Started
        </div>

        <script>
            let partiesData = [];

            async function showToast(msg) {
                const t = document.getElementById("toast");
                t.innerText = msg;
                t.style.transform = "translateY(0)";
                setTimeout(
                    () => (t.style.transform = "translateY(150%)"),
                    3000,
                );
            }

            async function refresh() {
                try {
                    const res = await fetch("/api/admin/scrape-status");
                    const data = await res.json();
                    partiesData = data;

                    const list = document.getElementById("party-list");
                    list.innerHTML = data
                        .map(
                            (p) => `
                        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                            <td class="p-4">
                                <div class="font-700 text-white">${p.title}</div>
                                <div class="text-[0.65rem] opacity-40 uppercase tracking-wider">${p.series || "No Series"} | ID: ${p.id}</div>
                            </td>
                            <td class="p-4">
                                <span class="px-2 py-0.5 rounded text-[0.6rem] font-800 uppercase ${p.status === "success" ? "bg-green-500/10 text-green-400" : p.status === "error" ? "bg-red-500/10 text-red-400" : "bg-yellow-500/10 text-yellow-400 border border-yellow-500/20"}">
                                    ${p.status || "not started"}
                                </span>
                                <div class="text-[0.6rem] opacity-30 mt-1">${p.images_saved || 0} / ${p.images_found || 0} saved</div>
                            </td>
                            <td class="p-4">
                                <span class="px-2 py-0.5 rounded text-[0.6rem] font-800 uppercase ${p.enriched_at ? "bg-purple-500/20 text-purple-300" : "bg-white/5 text-white/30"}">
                                    ${p.enriched_at ? "Enriched" : "Empty"}
                                </span>
                                <div class="text-[0.65rem] font-600 truncate max-w-[150px] opacity-60 mt-1">${p.location_name || "???"}</div>
                                <div class="text-[0.6rem] opacity-30">${p.party_date || ""}</div>
                            </td>
                            <td class="p-4">
                                <div class="text-[0.65rem] font-mono opacity-40 leading-tight">
                                    ${p.latitude ? p.latitude.toFixed(4) : "—"}<br/>
                                    ${p.longitude ? p.longitude.toFixed(4) : "—"}
                                </div>
                            </td>
                            <td class="p-4">
                                <div class="flex gap-2 items-center">
                                    <button class="bg-white/5 hover:bg-white/10 text-[0.6rem] px-2 py-1 rounded" onclick="window.scrape('${p.id}')">Scrape</button>
                                    <button class="bg-[#bc13fe]/10 hover:bg-[#bc13fe]/20 text-[#bc13fe] text-[0.6rem] px-2 py-1 rounded" onclick="window.enrich('${p.id}')">Enrich</button>
                                    <button class="bg-white/10 hover:bg-white/20 text-white text-[0.6rem] px-2 py-1 rounded font-700" onclick="window.edit('${p.id}')">Edit</button>
                                </div>
                            </td>
                        </tr>
                    `,
                        )
                        .join("");

                    document.getElementById("stat-total").innerText =
                        data.length;
                    document.getElementById("stat-scraped").innerText =
                        data.filter((p) => p.status === "success").length;
                    document.getElementById("stat-enriched").innerText =
                        data.filter((p) => p.enriched_at).length;
                } catch (e) {
                    console.error(e);
                }
            }

            window.scrape = async (id) => {
                showToast(`Scraping ${id}...`);
                await fetch(`/api/admin/scrape?id=${id}`);
                setTimeout(refresh, 2000);
            };

            window.enrich = async (id) => {
                showToast(`Enriching ${id}...`);
                await fetch(`/api/admin/enrich?id=${id}`);
                setTimeout(refresh, 1000);
            };

            window.edit = (id) => {
                const party = partiesData.find((p) => p.id === id);
                if (!party) return;

                document.getElementById("edit-id").value = party.id;
                document.getElementById("edit-title").value = party.title || "";
                document.getElementById("edit-series").value =
                    party.series || "";
                document.getElementById("edit-location").value =
                    party.location_name || "";
                document.getElementById("edit-lat").value =
                    party.latitude || "";
                document.getElementById("edit-lng").value =
                    party.longitude || "";
                document.getElementById("edit-date").value =
                    party.party_date || "";

                document.getElementById("edit-modal").showModal();
            };

            document.getElementById("edit-form").onsubmit = async (e) => {
                e.preventDefault();
                const id = document.getElementById("edit-id").value;
                const data = {
                    id,
                    title: document.getElementById("edit-title").value,
                    series: document.getElementById("edit-series").value,
                    location_name:
                        document.getElementById("edit-location").value,
                    latitude:
                        parseFloat(document.getElementById("edit-lat").value) ||
                        null,
                    longitude:
                        parseFloat(document.getElementById("edit-lng").value) ||
                        null,
                    party_date:
                        document.getElementById("edit-date").value || null,
                };

                showToast(`Updating ${id}...`);
                const res = await fetch("/api/admin/party/update", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data),
                });

                if (res.ok) {
                    document.getElementById("edit-modal").close();
                    refresh();
                } else {
                    alert("Failed to update party data");
                }
            };

            document.getElementById("btn-discover").onclick = async () => {
                showToast("Discovering new parties...");
                await fetch("/api/admin/discover");
                refresh();
            };

            document.getElementById("btn-scrape-all").onclick = async () => {
                showToast("Starting batch scrape...");
                await fetch("/api/admin/scrape");
                setTimeout(refresh, 5000);
            };

            document.getElementById("btn-enrich-next").onclick = async () => {
                showToast("Enriching next...");
                await fetch("/api/admin/enrich");
                setTimeout(refresh, 1000);
            };

            refresh();
            setInterval(refresh, 10000);
        </script>
    </body>
</html>
