---
import RaveButton from "../components/RaveButton.ts";
import OptionButton from "../components/OptionButton.ts";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="rave.arca.de.com - Indexing the SSB Productions rave photography archive."
    />
    <title>rave.arca.de.com | Ghost Rocket</title>
  </head>
  <body
    class="rave-bg premium-gradient min-h-screen flex flex-col items-center justify-center p-8 text-center font-sans focus:outline-none transition-all duration-1000"
    id="rave-body"
  >
    <!-- LANDING VIEW -->
    <div
      id="landing-view"
      class="flex flex-col items-center justify-center transition-opacity duration-500 absolute inset-0"
    >
      <header class="mb-12 animate-fade-in animate-duration-1000">
        <h1 class="text-6xl font-bold mb-4 tracking-tighter">
          GHOST <span class="text-purple-400">ROCKET</span>
        </h1>
        <p class="text-xl text-blue-200 opacity-80">
          The ultimate ravertastic experience at <span
            class="font-mono text-purple-300">rave.arca.de.com</span
          >
        </p>
      </header>

      <main
        class="min-h-screen w-full flex flex-col items-center justify-center p-4 relative overflow-hidden"
      >
        <!-- Game View (Immediate) -->
        <div
          id="game-view"
          class="w-full max-w-2xl flex flex-col items-center relative z-10"
        >
          <!-- Polaroid-style Image Container -->
          <div
            class="bg-white p-4 pb-16 shadow-2xl rotate-1 transition-transform duration-700 hover:rotate-0 mb-8 max-w-md w-full relative"
          >
            <div
              class="aspect-square bg-gray-100 overflow-hidden mb-4 relative grid place-items-center"
            >
              <!-- Loading Placeholder -->
              <div
                id="loading-spinner"
                class="absolute inset-0 flex items-center justify-center text-gray-400"
              >
                <div class="i-svg-spinners-90-ring-with-bg text-4xl"></div>
              </div>
              <img
                id="game-image"
                src=""
                class="w-full h-full object-cover opacity-0 transition-opacity duration-500"
                alt="Party moment"
              />
            </div>
            <div
              class="absolute bottom-4 left-4 right-4 flex justify-between items-end"
            >
              <div
                class="font-handwriting text-gray-600 text-xl transform -rotate-2"
              >
                Guess the party...
              </div>
              <div class="text-gray-300 text-sm">SSB ARCHIVE</div>
            </div>
          </div>

          <!-- Options Grid -->
          <div
            id="options-grid"
            class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full"
          >
            <!-- Options injected here -->
          </div>
        </div>

        <!-- Result Overlay (Absolute) -->
        <div
          id="result-overlay"
          class="fixed inset-0 z-50 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-300 bg-black/80 backdrop-blur-sm"
        >
          <div
            class="text-center transform scale-90 transition-transform duration-300 pointer-events-auto p-8 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md"
          >
            <h2
              id="result-title"
              class="text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-500 mb-4 drop-shadow-[0_0_15px_rgba(74,222,128,0.5)]"
            >
              NAILED IT!
            </h2>
            <p id="result-desc" class="text-xl text-gray-300 mb-8 font-light">
            </p>
            <button
              id="next-btn"
              class="px-8 py-3 bg-white text-black font-bold rounded-full hover:scale-105 active:scale-95 transition-transform shadow-[0_0_20px_rgba(255,255,255,0.3)]"
            >
              NEXT PHOTO →
            </button>
          </div>
        </div>

        <script>
          import "../components/OptionButton.ts";

          const game = document.getElementById("game-view");
          const gameImage = document.getElementById(
            "game-image",
          ) as HTMLImageElement;
          const optionsGrid = document.getElementById("options-grid");
          const resultOverlay = document.getElementById("result-overlay");
          const resultTitle = document.getElementById("result-title");
          const resultDesc = document.getElementById("result-desc");
          const nextBtn = document.getElementById("next-btn");
          const loadingSpinner = document.getElementById("loading-spinner");

          let currentQuiz: any = null;

          // Start immediately
          loadGame();

          async function loadGame() {
            // Reset State
            resetOverlay();
            gameImage.classList.add("opacity-0");
            loadingSpinner?.classList.remove("hidden");

            // Fetch Data
            try {
              const res = await fetch("/api/quiz");
              currentQuiz = await res.json();
              renderQuiz(currentQuiz);
            } catch (e) {
              console.error("Rave API Error", e);
            }
          }

          function renderQuiz(quiz: any) {
            // Preload image
            const img = new Image();
            img.src = quiz.imageUrl;
            img.onload = () => {
              gameImage.src = quiz.imageUrl;
              loadingSpinner?.classList.add("hidden");
              gameImage.classList.remove("opacity-0");
            };

            // Render Options
            if (optionsGrid) {
              optionsGrid.innerHTML = "";
              quiz.options.forEach((opt: any) => {
                const btn = document.createElement("option-button");
                btn.setAttribute("label", opt.label);
                btn.setAttribute("value", opt.id);
                // @ts-ignore
                btn.onclick = () => handleGuess(opt.id, btn);
                optionsGrid.appendChild(btn);
              });
            }
          }

          function handleGuess(selectedId: string, btnElement: any) {
            if (!currentQuiz) return;
            const isCorrect = selectedId === currentQuiz.correctId;

            // Visual Feedback on Buttons
            const allBtns = optionsGrid?.querySelectorAll("option-button");
            allBtns?.forEach((b: any) => {
              if (b.getAttribute("value") === currentQuiz.correctId) {
                b.setAttribute("state", "correct");
              } else if (b === btnElement && !isCorrect) {
                b.setAttribute("state", "wrong");
              } else {
                b.setAttribute("state", "default");
                b.style.opacity = "0.5"; // Dim others
              }
              b.style.pointerEvents = "none"; // Lock input
            });

            // Show Overlay
            if (resultTitle && resultDesc && resultOverlay) {
              resultTitle.textContent = isCorrect ? "NAILED IT!" : "NOPE!";
              resultTitle.className = isCorrect
                ? "text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-500 mb-4 drop-shadow-[0_0_15px_rgba(74,222,128,0.5)]"
                : "text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-pink-600 mb-4 drop-shadow-[0_0_15px_rgba(239,68,68,0.5)]";

              resultDesc.textContent = isCorrect
                ? "The vibe is correct."
                : `It was actually ${currentQuiz.options.find((o: any) => o.id === currentQuiz.correctId)?.label}`;

              resultOverlay.classList.remove(
                "opacity-0",
                "pointer-events-none",
              );
            }
          }

          function resetOverlay() {
            resultOverlay?.classList.add("opacity-0", "pointer-events-none");
            if (gameImage) gameImage.src = ""; // Clear to avoid flash
            loadingSpinner?.classList.remove("hidden"); // Show spinner again for next load
          }

          nextBtn?.addEventListener("click", loadGame);
        </script>
      </main>
    </div>
  </body>
</html>
