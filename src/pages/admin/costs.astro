---
// Cost Assessment Page for Rave Archive
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>COST ASSESSMENT | RAVE ADMIN</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            :root {
                --neon-purple: #bc13fe;
                --neon-blue: #00f3ff;
                --neon-pink: #ff00ff;
                --dark-bg: #0a0a0c;
            }

            body {
                margin: 0;
                background-color: var(--dark-bg);
                color: #e0e0e0;
                font-family: "Inter", sans-serif;
                background-image:
                    radial-gradient(
                        circle at 20% 30%,
                        rgba(188, 19, 254, 0.15) 0%,
                        transparent 50%
                    ),
                    radial-gradient(
                        circle at 80% 70%,
                        rgba(0, 243, 255, 0.15) 0%,
                        transparent 50%
                    );
                min-height: 100vh;
            }
        </style>
    </head>
    <body class="p-8">
        <div class="max-w-7xl mx-auto">
            <header
                class="flex justify-between items-center mb-12 border-b border-white/10 pb-6"
            >
                <div class="flex items-center gap-4">
                    <a
                        href="/admin"
                        class="text-white/40 hover:text-white transition-all"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 19l-7-7 7-7"></path>
                        </svg>
                    </a>
                    <h1
                        class="text-4xl font-900 tracking-tighter bg-gradient-to-r from-white to-[#00f3ff] bg-clip-text text-transparent"
                    >
                        COST <span class="text-[#bc13fe]">ASSESSMENT</span>
                    </h1>
                </div>
            </header>

            <cost-dashboard></cost-dashboard>
        </div>

        <script>
            import "../../components/CostDashboard.ts";
        </script>
    </body>
</html>
