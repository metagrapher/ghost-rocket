{
    "name": "ghost-rocket-test",
    "compatibility_date": "2026-01-07",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "rave-archive-test"
        }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "rave-data-test",
            "database_id": "34fd284e-91b6-40f1-aa71-5f5bc38c3e8a"
        }
    ],
    "browser": {
        "binding": "BROWSER"
    },
    "ai": {
        "binding": "AI"
    }
}